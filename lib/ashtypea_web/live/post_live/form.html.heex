<Layouts.app flash={@flash} current_scope={@current_scope}>

	<div class="max-w-3xl mx-auto p-6">
		<h1 class="text-2xl font-semibold mb-6">{(@page_title || "New Post")}</h1>

		<.form for={@form} id="post-form" phx-change="validate" phx-submit="save">
			<div class="space-y-4">
				<.input field={@form[:title]} type="text" label="Title" id="post-title" required />

				<.input field={@form[:body]} type="textarea" label="Body" id="post-body" rows="6" />

				<.input field={@form[:published]} type="checkbox" label="Published" id="post-published" />

				<div class="pt-4 flex items-center space-x-3">
					<button type="submit" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded">Save</button>
					<.link navigate="/posts" class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600">Cancel</.link>
				</div>
			</div>
		</.form>
	</div>

</Layouts.app>