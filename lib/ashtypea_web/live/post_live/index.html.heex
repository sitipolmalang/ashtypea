<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    Posts
    <:actions>
      <.link patch={~p"/posts/new"}>
        <.button>New Post</.button>
      </.link>
    </:actions>
  </.header>

  <Cinder.collection
    id="post-collection"
    resource={Ashtypea.Blog.Post}
    actor={assigns[:current_user]}
    url_state={@url_state}
    page_size={10}
    query_opts={[load: [:user]]}
    empty_message="No posts found."
    click={fn post -> JS.push("show_post", value: %{id: post.id}) end}
    selectable
  >
    <:col :let={post} field="title" sort label="Title" filter>{post.title}</:col>
    <:col :let={post} field="body" label="Body">{post.body}</:col>
    <:col :let={post} field="user.email" label="Author">{post.user.email}</:col>
    

    <:col :let={post} label="Actions" class="w-px whitespace-nowrap">
    <div class="flex materials-center gap-4">
      <.link
        patch={~p"/posts/#{post.id}/edit"}
        class="text-sm font-medium text-blue-600 hover:text-blue-500
               dark:text-blue-400 dark:hover:text-blue-300 transition-colors duration-150"
      >
        Edit
      </.link>
      <.link
        phx-click="delete"
        phx-value-id={post.id}
        data-confirm="Delete this post? This cannot be undone."
        class="text-sm font-medium text-red-600 hover:text-red-500
               dark:text-red-400 dark:hover:text-red-300 transition-colors duration-150"
      >
        Delete
      </.link>
    </div>
  </:col>
  </Cinder.collection>
</Layouts.app>